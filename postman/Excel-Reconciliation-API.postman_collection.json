              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"category is travel\", () => pm.expect(r.category).to.eql(\"travel\"));",
                  "pm.test(\"both portal tabs detected\", () => pm.expect(r.detected.find(d => d.role === \"portal\").sheets.length).to.be.above(0));",
                  "pm.test(\"bookings are grouped\", () => pm.expect(r.summary.portal_bookings).to.be.at.most(r.summary.portal_rows));",
