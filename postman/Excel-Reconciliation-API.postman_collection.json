{
  "info": {
    "_postman_id": "f8a6ae7b-2945-464f-872c-68e7f4fee6e3",
    "name": "Excel Reconciliation API",
    "description": "All endpoints of the reconciliation service, in run order.\n\n**Before running**\n1. Start the API: `cd backend && uv run fastapi dev app/main.py --port 6050`\n2. Migrate the database once (`uv run alembic upgrade head`): it seeds the login account from `app/seed/users.json`.\n3. Set the collection variables `username` and `password` to that account.\n4. Settings → General → Working directory → choose `backend/tests/fixtures`, so the file fields find workings.xlsx and vendor_statement.xlsx for eShop, and travel/portal.xlsx, travel/claim_13.xlsx and travel/wallet_history.xlsx for travel.\n\n**Authentication** is an HttpOnly cookie set by *Login*. Postman stores and resends it automatically for the same host, so nothing needs to be copied between requests. It lasts 60 minutes; re-run *Login* after that.\n\n**Categories** (eShop, Travel, Food, and any added later) are set up in the database and versioned: *Current setup* is what runs use, and saving makes a new version. **Runs** are kept in History with their files, report and the version they used.\n\n**Running this collection** adds runs to History and replaces the travel portal template. It saves no setup and creates no category.\n\n**Money** comes back as decimal strings (\"13876.31\"), never JSON numbers.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:6050",
      "type": "string"
    },
    {
      "key": "username",
      "value": "admin",
      "type": "string"
    },
    {
      "key": "password",
      "value": "CHANGE_ME",
      "type": "string"
    },
    {
      "key": "travel_config",
      "value": "",
      "type": "string"
    },
    {
      "key": "travel_version",
      "value": "",
      "type": "string"
    },
    {
      "key": "run_number",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/utils/health-check/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "utils",
                "health-check",
                ""
              ]
            },
            "description": "Unauthenticated liveness probe. Returns the bare JSON literal `true`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"body is true\", () => pm.expect(pm.response.json()).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Session",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/login/access-token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "login",
                "access-token"
              ]
            },
            "description": "Body is **x-www-form-urlencoded**, not JSON. On success sets the `access_token` cookie (HttpOnly, Max-Age=3600). The token is never in the body.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{username}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"echoes the username\", () => pm.expect(pm.response.json().username).to.eql(pm.collectionVariables.get(\"username\")));",
                  "pm.test(\"session cookie was set\", () => pm.expect(pm.cookies.has(\"access_token\")).to.be.true);",
                  "pm.test(\"token is not in the body\", () => pm.expect(pm.response.text()).to.not.include(\"access_token\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me (check session)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/login/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "login",
                "me"
              ]
            },
            "description": "Returns the logged-in account, or 401 when the cookie is missing or expired."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns the account\", () => pm.expect(pm.response.json()).to.have.property(\"username\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Categories and setups",
      "item": [
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/categories",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "categories"
              ]
            },
            "description": "Every category, the files it takes and the version of its setup that runs use."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"the three approved categories\", () => pm.expect(r.map(c => c.key)).to.include.members([\"eshop\", \"travel\", \"food\"]));",
                  "pm.test(\"travel takes a portal export and a vendor claim\", () => pm.expect(r.find(c => c.key === \"travel\").inputs.filter(i => i.required).map(i => i.role)).to.eql([\"portal\", \"vendor\"]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Current setup",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/categories/travel/config",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "categories",
                "travel",
                "config"
              ]
            },
            "description": "The setup runs use now: uploads, formulas, status rules and the report layout. Kept in collection variables for the next requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"has a version\", () => pm.expect(r.version).to.be.a(\"number\"));",
                  "pm.test(\"travel setup\", () => pm.expect(r.config.category).to.eql(\"travel\"));",
                  "pm.collectionVariables.set(\"travel_config\", JSON.stringify(r.config));",
                  "pm.collectionVariables.set(\"travel_version\", r.version);"
                ]
              }
            }
          ]
        },
        {
          "name": "Saved versions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/categories/travel/versions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "categories",
                "travel",
                "versions"
              ]
            },
            "description": "Every saved version, newest first, with its note."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"version 1 is kept\", () => pm.expect(pm.response.json().map(v => v.number)).to.include(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Check a setup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/categories/travel/check",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "categories",
                "travel",
                "check"
              ]
            },
            "description": "What the editor calls on every edit: the problems to fix, and what each formula reads.",
            "body": {
              "mode": "raw",
              "raw": "{\"config\": {{travel_config}}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"nothing to fix\", () => pm.expect(r.problems).to.eql([]));",
                  "pm.test(\"lineage for the formulas\", () => pm.expect(r.lineage.length).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Function library",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/functions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "functions"
              ]
            },
            "description": "The functions a formula can call, for the editor's help."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"IF is listed\", () => pm.expect(pm.response.json().map(f => f.name)).to.include(\"IF\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload a template file",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/categories/travel/templates/portal",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "categories",
                "travel",
                "templates",
                "portal"
              ]
            },
            "description": "A sample of an upload, for the editor: its sheets, headers and first rows. Replaces the previous one for that file.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "travel/portal.xlsx"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"role is portal\", () => pm.expect(r.role).to.eql(\"portal\"));",
                  "pm.test(\"sheets and headers read\", () => pm.expect(r.sheets[0].columns.length).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Template files",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/categories/travel/templates",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "categories",
                "travel",
                "templates"
              ]
            },
            "description": "The template files the category has."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"the portal template\", () => pm.expect(pm.response.json().map(t => t.role)).to.include(\"portal\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Preview a setup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/categories/travel/preview",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "categories",
                "travel",
                "preview"
              ]
            },
            "description": "Runs a setup, saved or not, on the template files (`\"run\": null`) or on a past run's files (`\"run\": 1`), and keeps nothing. Needs a portal and a vendor template, or a past run.",
            "body": {
              "mode": "raw",
              "raw": "{\"config\": {{travel_config}}, \"run\": null}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200, or 404 with no files to preview on\", () => pm.expect(pm.response.code).to.be.oneOf([200, 404]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Save on an old version (409)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/categories/travel/config",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "categories",
                "travel",
                "config"
              ]
            },
            "description": "Saving makes a new version, which the next run uses. `base_version` is the version the edit started from; if someone saved since, the save is refused rather than overwrite theirs. Send the current `{{travel_version}}` to really save.",
            "body": {
              "mode": "raw",
              "raw": "{\"config\": {{travel_config}}, \"note\": \"Example\", \"base_version\": 0}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"409 Conflict\", () => pm.response.to.have.status(409));",
                  "pm.test(\"nothing was saved\", () => pm.expect(pm.response.json().detail).to.include(\"was saved after version 0\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "New category with a bad key (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/categories",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "categories"
              ]
            },
            "description": "A new category starts blank, or as a copy of another (`\"copy_of\": \"travel\"`). Its key is lowercase letters, digits and underscores.",
            "body": {
              "mode": "raw",
              "raw": "{\"key\": \"Bad Key!\", \"name\": \"Example\", \"copy_of\": null}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"422\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Runs",
      "item": [
        {
          "name": "Run eShop",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/runs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "runs"
              ]
            },
            "description": "One file per input the category takes (see List categories). The run is kept in History with its files, its report and the setup version it used. Can take minutes on very large files.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "category",
                  "type": "text",
                  "value": "eshop"
                },
                {
                  "key": "portal",
                  "type": "file",
                  "src": "workings.xlsx"
                },
                {
                  "key": "promo",
                  "type": "file",
                  "src": "workings.xlsx"
                },
                {
                  "key": "vendor",
                  "type": "file",
                  "src": "vendor_statement.xlsx"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"completed\", () => pm.expect(r.status).to.eql(\"completed\"));",
                  "pm.test(\"34 orders counted, 3 not\", () => { pm.expect(r.summary.counted).to.eql(34); pm.expect(r.summary.not_counted).to.eql(3); });",
                  "pm.test(\"net payable 13876.31, as a string\", () => pm.expect(r.summary.net_payable).to.eql(\"13876.31\"));",
                  "pm.collectionVariables.set(\"run_number\", r.number);"
                ]
              }
            }
          ]
        },
        {
          "name": "Run travel with the wallet history",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/runs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "runs"
              ]
            },
            "description": "The wallet history and the finance report are optional files.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "category",
                  "type": "text",
                  "value": "travel"
                },
                {
                  "key": "portal",
                  "type": "file",
                  "src": "travel/portal.xlsx"
                },
                {
                  "key": "vendor",
                  "type": "file",
                  "src": "travel/claim_13.xlsx"
                },
                {
                  "key": "wallet",
                  "type": "file",
                  "src": "travel/wallet_history.xlsx"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"completed\", () => pm.expect(r.status).to.eql(\"completed\"));",
                  "pm.test(\"7 bookings counted\", () => pm.expect(r.summary.counted).to.eql(7));",
                  "pm.test(\"the wallet file is kept\", () => pm.expect(r.files.map(f => f.role)).to.include(\"wallet\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Run with a rate override",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/runs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "runs"
              ]
            },
            "description": "A category's rates can be set for one run (travel: hotel_rate, flight_rate, vat_rate; eShop: standard_rate, promo_rate, promo_cutoff). The run records the rates it used.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "category",
                  "type": "text",
                  "value": "travel"
                },
                {
                  "key": "portal",
                  "type": "file",
                  "src": "travel/portal.xlsx"
                },
                {
                  "key": "vendor",
                  "type": "file",
                  "src": "travel/claim_13.xlsx"
                },
                {
                  "key": "flight_rate",
                  "type": "text",
                  "value": "0.04"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"the override is recorded\", () => pm.expect(pm.response.json().parameters.flight_rate).to.eql(\"0.04\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Run with an explicit period",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/runs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "runs"
              ]
            },
            "description": "Without a period, it is worked out from the files.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "category",
                  "type": "text",
                  "value": "eshop"
                },
                {
                  "key": "portal",
                  "type": "file",
                  "src": "workings.xlsx"
                },
                {
                  "key": "promo",
                  "type": "file",
                  "src": "workings.xlsx"
                },
                {
                  "key": "vendor",
                  "type": "file",
                  "src": "vendor_statement.xlsx"
                },
                {
                  "key": "period_start",
                  "type": "text",
                  "value": "2026-01-01"
                },
                {
                  "key": "period_end",
                  "type": "text",
                  "value": "2026-12-31"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"the period given\", () => pm.expect(r.period_start).to.eql(\"2026-01-01\"));",
                  "pm.test(\"statement rows inside it are real breaks\", () => pm.expect(r.exception_counts.by_code.MISSING_FROM_PORTAL).to.eql(21));"
                ]
              }
            }
          ]
        },
        {
          "name": "A file that does not fit (failed run)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/runs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "runs"
              ]
            },
            "description": "An eShop statement where the travel claim belongs. The run is still created and kept, failed, with the reason; the status code is 201.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "category",
                  "type": "text",
