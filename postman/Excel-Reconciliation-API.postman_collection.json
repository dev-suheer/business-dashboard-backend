{
  "info": {
    "_postman_id": "f8a6ae7b-2945-464f-872c-68e7f4fee6e3",
    "name": "Excel Reconciliation API",
    "description": "All endpoints of the reconciliation service, in run order.\n\n**Before running**\n1. Start the API: `cd backend && uv run fastapi dev app/main.py --port 6050`\n2. Create the login account once: `uv run python app/create_credentials.py`\n3. Set the collection variables `username` and `password` to that account.\n4. Settings \u2192 General \u2192 Working directory \u2192 choose the repo's `sample-uploads` folder, so the file fields find portal.xlsx, vendor.xlsx and promo.xlsx for eShop, and travel-portal.xlsx, travel-claim.xlsx and wallet-history.xlsx for travel.\n\n**Authentication** is an HttpOnly cookie set by *Login*. Postman stores and resends it automatically for the same host, so nothing needs to be copied between requests. It lasts 60 minutes; re-run *Login* after that.\n\n**Two categories.** eShop reconciles order lines against an account ledger; travel reconciles bookings against the vendor's weekly claim and has its own endpoint and result shape.\n\n**Money** comes back as decimal strings (\"13876.31\"), never JSON numbers.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:6050",
      "type": "string"
    },
    {
      "key": "username",
      "value": "admin",
      "type": "string"
    },
    {
      "key": "password",
      "value": "CHANGE_ME",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/utils/health-check/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "utils",
                "health-check",
                ""
              ]
            },
            "description": "Unauthenticated liveness probe. Returns the bare JSON literal `true`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"body is true\", () => pm.expect(pm.response.json()).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Session",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/login/access-token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "login",
                "access-token"
              ]
            },
            "description": "Body is **x-www-form-urlencoded**, not JSON. On success sets the `access_token` cookie (HttpOnly, Max-Age=3600). The token is never in the body.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{username}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"echoes the username\", () => pm.expect(pm.response.json().username).to.eql(pm.collectionVariables.get(\"username\")));",
                  "pm.test(\"session cookie was set\", () => pm.expect(pm.cookies.has(\"access_token\")).to.be.true);",
                  "pm.test(\"token is not in the body\", () => pm.expect(pm.response.text()).to.not.include(\"access_token\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me (check session)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/login/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "login",
                "me"
              ]
            },
            "description": "Returns the logged-in account, or 401 when the cookie is missing or expired."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns the account\", () => pm.expect(pm.response.json()).to.have.property(\"username\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Reconcile",
      "item": [
        {
          "name": "Reconcile \u2014 JSON",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/reconcile",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "reconcile"
              ]
            },
            "description": "The main call. Three files as multipart form-data. Returns the full reconciliation. Can take minutes on very large files.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "portal",
                  "type": "file",
                  "src": "portal.xlsx",
                  "description": "Portal export (order lines)"
                },
                {
                  "key": "vendor",
                  "type": "file",
                  "src": "vendor.xlsx",
                  "description": "Vendor account statement"
                },
                {
                  "key": "promo",
                  "type": "file",
                  "src": "promo.xlsx",
                  "description": "Discount base sheet (promo SKUs)"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"all eleven top-level keys\", () => pm.expect(r).to.have.all.keys(\"category\",\"merchant_id\",\"period_start\",\"period_end\",\"rates\",\"orders\",\"unmatched_ledger\",\"line_variances\",\"exceptions\",\"detected\",\"summary\"));",
                  "pm.test(\"portal tab detected\", () => pm.expect(r.detected.find(d => d.role === \"portal\").sheets).to.eql([\"E-SHop 1 Vendor \"]));",
                  "pm.test(\"promo tab detected\", () => pm.expect(r.detected.find(d => d.role === \"promo\").sheets).to.eql([\"Discount Base Sheet\"]));",
                  "pm.test(\"37 orders from 75 lines\", () => { pm.expect(r.summary.orders).to.eql(37); pm.expect(r.summary.portal_lines).to.eql(75); });",
                  "pm.test(\"net payable 13876.31\", () => pm.expect(r.summary.net_payable).to.eql(\"13876.31\"));",
                  "pm.test(\"money is a string\", () => pm.expect(r.summary.net_payable).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
